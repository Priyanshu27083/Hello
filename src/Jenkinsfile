
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                bat '''
                    if exist out rmdir /s /q out
                    mkdir out
                    javac -d out src\\Hello.java
                '''
            }
        }

        stage('Run') {
            steps {
                bat '''
                    java -cp out Hello > artifact.txt
                    type artifact.txt
                '''
            }
        }
    }
}
